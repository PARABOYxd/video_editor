# Video editor portfolio: environment variables
# Copy to .env.local for development, or add them in Vercel > Project > Settings > Environment Variables.
# Nothing is required to run locally: without DATABASE_URL a local database (PGlite) is used.
# Content (names, contact details, projects, services...) is edited in /admin, not here.

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical domain, no trailing slash. Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Set to false on preview/staging deploys to block search engines.
NEXT_PUBLIC_ALLOW_INDEXING=true

# ── Database (required on Vercel to save anything) ──────────────────────────
# Any Postgres: Neon (Vercel Marketplace), Supabase, etc. Use the POOLED connection string.
# Tables are created and seeded automatically on first request.
DATABASE_URL=

# ── Thumbnail uploads (required on Vercel for uploads) ──────────────────────
# Vercel > Storage > Blob > create store; this token is added for you when you connect it.
BLOB_READ_WRITE_TOKEN=

# ── Videos on Cloudflare R2 (optional) ──────────────────────────────────────
# Upload only videos you own or have licensed to an R2 bucket with public access on,
# then paste the bucket's public URL. "/videos/x.mp4" becomes "<this>/x.mp4".
# Leave empty to serve videos from public/videos (local only; it is git-ignored).
MEDIA_BASE_URL=

# ── Admin login (/admin) ────────────────────────────────────────────────────
# Run:  pnpm admin:hash "a-long-password"
# and paste the two lines it prints. The password itself is never stored.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
