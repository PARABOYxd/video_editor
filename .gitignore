# ── Dependencies ───────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ───────────────────────────────────────
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ── Environment / secrets ──────────────────────────────────────
# .env.local holds the admin password hash and session secret.
# Only the documented template is committed.
.env*
!.env.example
*.pem

# ── Local development data ─────────────────────────────────────
# PGlite database used when DATABASE_URL is not set
/.data
# Images uploaded through the admin while running locally
/public/uploads

# ── Media that must not be committed ───────────────────────────
# Video files don't belong in git (size limits, slow clones). Host videos on
# YouTube / Vimeo / Vercel Blob and paste the link in the admin.
# The files currently in public/videos are a third-party film trailer
# (Brain Farm, "View From A Blue Moon") and are not used by the site.
/public/videos/
*.mp4
*.mov
*.webm
*.m4v
# Poster of that same third-party film (unused)
/public/images/showreel-poster.jpg

# ── Testing / tooling ──────────────────────────────────────────
/coverage
/playwright-report
/test-results

# ── Logs ───────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Editors / OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# ── Deploy / assistant local settings ──────────────────────────
.vercel
.claude/settings.local.json
